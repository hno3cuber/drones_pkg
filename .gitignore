# 构建产物（标准 colcon 位置在工作空间根目录，此处兜底）
build/
install/
log/
_colcon/

# 编辑器 / 系统
.vscode/
.idea/
*.swp
.DS_Store
__pycache__/

# 工作过程中的临时备份（不参与版本控制）
.backup/

# Windows 从压缩包/网络下载时产生的标记文件
*:Zone.Identifier

# 沙箱内旁路构建产物（--build-base/--install-base/--log-base 指向此处）
.colcon_build/
.colcon_install/
.colcon_log/

# 话题调试转储
dump.txt

# 本地临时分析产物（脚本、csv 转储、探针输出）
.tmp_*
